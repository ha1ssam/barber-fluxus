# Banco
DATABASE_URL="postgresql://fluxus:fluxus@localhost:5432/fluxus"

# URL pública do app (usada nos links das mensagens e e-mails)
APP_URL="http://localhost:3000"
# Segredo para criptografar tokens guardados no banco (mínimo 32 caracteres)
APP_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Protege /api/cron/* (o worker e cron externo mandam no header Authorization: Bearer ...)
CRON_SECRET="troque-tambem"

# E-mail (Resend). Sem chave, os e-mails são escritos no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="Fluxus <noreply@seudominio.com.br>"

# Login com Google (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (opcional; sem chave a página de assinatura mostra os planos sem checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENCIAL=""
STRIPE_PRICE_EQUIPE=""

# WhatsApp por QR Code: serviço services/whatsapp-gateway
WHATSAPP_GATEWAY_URL="http://localhost:4010"
WHATSAPP_GATEWAY_SECRET=""

# WhatsApp pela API oficial da Meta (webhook)
META_WEBHOOK_VERIFY_TOKEN=""
META_APP_SECRET=""

# Notificação push (PWA). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seudominio.com.br"
